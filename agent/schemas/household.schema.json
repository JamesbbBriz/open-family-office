{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Family Office v1 \u2014 input contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "base_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "synthetic": {
      "type": "boolean"
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "ownership_share": {
            "type": "string",
            "pattern": "^(0(\\.\\d+)?|1(\\.0+)?)$"
          },
          "owner_id": {
            "type": "string",
            "minLength": 1
          },
          "valuation_date": {
            "type": "string",
            "format": "date"
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": [
              "cash",
              "equity",
              "bond",
              "real_estate",
              "private_business",
              "private_credit",
              "commodity",
              "crypto",
              "collectible",
              "other"
            ]
          },
          "wrapper": {
            "type": "string",
            "minLength": 1
          },
          "liquidity_days": {
            "type": "integer",
            "minimum": 0
          },
          "restriction": {
            "enum": [
              "none",
              "locked",
              "pledged"
            ]
          },
          "investable": {
            "type": "boolean"
          },
          "liquidation_haircut": {
            "type": "string",
            "pattern": "^(0(\\.\\d+)?|1(\\.0+)?)$"
          },
          "valuation_basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label",
          "value",
          "currency",
          "ownership_share",
          "owner_id",
          "valuation_date",
          "evidence_id",
          "class",
          "wrapper",
          "liquidity_days",
          "restriction",
          "investable",
          "liquidation_haircut",
          "valuation_basis"
        ],
        "additionalProperties": false
      }
    },
    "liabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "ownership_share": {
            "type": "string",
            "pattern": "^(0(\\.\\d+)?|1(\\.0+)?)$"
          },
          "owner_id": {
            "type": "string",
            "minLength": 1
          },
          "valuation_date": {
            "type": "string",
            "format": "date"
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label",
          "value",
          "currency",
          "ownership_share",
          "owner_id",
          "valuation_date",
          "evidence_id",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "cashflows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "in",
              "out"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "recurrence": {
            "enum": [
              "monthly",
              "one_off"
            ]
          },
          "nature": {
            "enum": [
              "stable",
              "variable",
              "one_off",
              "principal_return"
            ]
          },
          "amount": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "amount_basis": {
            "const": "household_net_after_tax"
          }
        },
        "required": [
          "id",
          "label",
          "direction",
          "category",
          "recurrence",
          "nature",
          "amount",
          "currency",
          "start_date",
          "end_date",
          "evidence_id",
          "amount_basis"
        ],
        "additionalProperties": false
      }
    },
    "fx": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "base_per_unit": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "as_of": {
            "type": "string",
            "format": "date"
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "base_per_unit",
          "as_of",
          "evidence_id"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "synthetic",
              "user_statement",
              "document",
              "official_source",
              "assumption"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "as_of": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "source",
          "as_of",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "risk_preferences": {
      "type": "object",
      "properties": {
        "willingness": {
          "enum": [
            "unknown",
            "low",
            "medium",
            "high"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "willingness",
        "note"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "as_of",
    "base_currency",
    "synthetic",
    "entities",
    "assets",
    "liabilities",
    "cashflows",
    "fx",
    "evidence",
    "risk_preferences",
    "notes"
  ],
  "additionalProperties": false,
  "$comment": "Runtime also checks ID references, duplicate IDs, finite decimals, percentages, date order and unsupported valuation bases. Run scripts/ofo.py validate."
}
